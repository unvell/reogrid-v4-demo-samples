<Application x:Class="ReoGridWPFSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReoGridWPFSample"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate x:Key="GroupedDropdownTreeTemplate">
            <!-- グループ付きドロップダウン用 TreeView -->
            <TreeView MinWidth="260"
                      Background="White"
                      BorderThickness="2"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">

                <TreeView.Resources>

                    <!-- グループ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:GroupNode}"
                                          ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding GroupName}"
                               FontWeight="SemiBold"
                               Margin="4,2"/>
                    </HierarchicalDataTemplate>

                    <!-- アイテム -->
                    <DataTemplate DataType="{x:Type local:ItemNode}">
                        <TextBlock Text="{Binding ItemName}"
                               Margin="16,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE6F2FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>

                    <!-- TreeViewItem Style -->
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="False"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>

                </TreeView.Resources>
            </TreeView>
        </DataTemplate>
    </Application.Resources>
</Application>
